# Copy to .env and edit. .env is gitignored; this file is not.

# --- Identity (non-negotiable #6) -------------------------------------------
# One User-Agent. It must name the project and carry a contact route, and
# crawler/run.py refuses to start until it does -- see check_user_agent().
#
# A URL alone is sufficient. An email is NOT required, and requiring one only
# encourages fake ones. What matters is that an operator reading their access
# log at 3am can find out what hit them and tell someone to stop.
#
# Rejected: any of YOURNAME / YOUR_EMAIL_HERE / example.com / changeme / todo,
# anything not naming arc_search, anything with no URL or email at all.
ARC_CRAWL_USER_AGENT=arc_search/0.1 (+https://github.com/YOURNAME/arc_search)

# --- Crawl ------------------------------------------------------------------
# ARC_CRAWL_PER_HOST_RPS=0.5
# ARC_CRAWL_CONCURRENCY=16
# ARC_CRAWL_FRONTIER_PATH=data/frontier.sqlite

# --- Storage ----------------------------------------------------------------
# Password comes from PGPASSWORD or .pgpass, never the DSN.
# ARC_INDEX_PG_DSN=postgresql://arc@127.0.0.1:5432/arc_search
# ARC_INDEX_QDRANT_URL=http://127.0.0.1:6333

# Read by docker-compose.yml, NOT by the app -- compose refuses to start
# without it. Listed in config._EXTERNAL_VARS so the typo check ignores it.
ARC_PG_PASSWORD=generate-one-and-keep-it-here

# Opt-in switch for the database integration tests. Unset means they skip.
#
# These tests TRUNCATE every table, so they refuse any database whose name does
# not end in _test. Point this at the crawl corpus and you would lose it; the
# guard exists because that already happened once, mid-crawl.
#   docker exec arc_search-postgres-1 createdb -U arc arc_search_test
#   docker exec -i arc_search-postgres-1 psql -U arc -d arc_search_test < sql/schema.sql
# ARC_TEST_PG_DSN=postgresql://arc@127.0.0.1:5432/arc_search_test
